# =============================================
# TEST CONFIGURATIE: 2 Storage Zones + 2 Pull Zones
# =============================================

# Storage Zones (S3)
storage_zones = {
  "test-klant1" = {
    name      = "test-klant1-storage"
    region    = "DE"
    zone_tier = "Edge"  # Goedkoopste optie
  }
  "test-klant2" = {
    name      = "test-klant2-storage"
    region    = "DE"
    zone_tier = "Edge"
  }
}

# Pull Zones (CDN) - gekoppeld aan storage zones
pull_zones = {
  "test-klant1-cdn" = {
    name           = "test-klant1-cdn"
    origin_url     = "https://example.com"  # Vervang met echte origin
    origin_host_header = "example.com"
    storage_zone_id = "test-klant1"  # Koppelt aan storage zone hierboven
  }
  "test-klant2-cdn" = {
    name           = "test-klant2-cdn"
    origin_url     = "https://example.com"  # Vervang met echte origin
    origin_host_header = "example.com"
    storage_zone_id = "test-klant2"  # Koppelt aan storage zone hierboven
  }
}
