# =============================================
# VOORBEELD CONFIGURATIE: Storage Zones + Pull Zones
# =============================================

# Storage Zones (S3)
storage_zones = {
  "klant1" = {
    name      = "klant1-storage"
    region    = "DE"
    zone_tier = "Edge"  # Goedkoopste optie
  }
  "klant2" = {
    name      = "klant2-storage"
    region    = "DE"
    zone_tier = "Edge"
  }
}

# Pull Zones (CDN)
# Als storage_zone_id is ingesteld, wordt de storage zone hostname
# automatisch gebruikt als origin. Externe origin_url is optioneel.
pull_zones = {
  "klant1-cdn" = {
    name            = "klant1-cdn"
    storage_zone_id = "klant1"  # Gebruikt storage zone als origin
    # origin_url is OPTIONEEL - niet nodig voor storage zone koppeling
  }
  "klant2-cdn" = {
    name            = "klant2-cdn"
    storage_zone_id = "klant2"
    # Voor externe origin (optioneel):
    # origin_url     = "https://jouw-website.nl"
    # origin_host_header = "jouw-website.nl"
  }
}
